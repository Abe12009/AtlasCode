# Copy to .env and fill in real values. Never commit the real .env file.

# Application
APP_NAME=AtlasCode
# true for local development, false in production
DEBUG=true

# Local dev default (SQLite). In production, set to a PostgreSQL URL, e.g.
# postgresql://user:password@host:5432/dbname
# (postgres:// / postgresql:// are normalized to the async psycopg driver automatically)
DATABASE_URL=sqlite+aiosqlite:///./atlascode.db

# Generate a real value for production, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# JSON array or comma-separated list of allowed frontend origins.
# Local dev: http://localhost:5173
# Production: your Vercel deployment URL(s), e.g. https://atlascode.vercel.app
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
