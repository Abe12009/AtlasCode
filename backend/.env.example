# Copy to .env and fill in real values. Never commit the real .env file.

# Application
APP_NAME=AtlasCode
# true for local development, false in production
DEBUG=true

# Local dev default (SQLite). In production, set to a PostgreSQL URL, e.g.
# postgresql://user:password@host:5432/dbname
# (postgres:// / postgresql:// are normalized to the async psycopg driver automatically)
DATABASE_URL=sqlite+aiosqlite:///./atlascode.db

# Generate a real value for production, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# JSON array or comma-separated list of allowed frontend origins.
# Local dev: http://localhost:5173
# Production: your Vercel deployment URL(s), e.g. https://atlascode.vercel.app
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- Federated authentication (optional) -----------------------------------
# Firebase project id. PUBLIC value — it also ships in the web client. Leave it
# empty to disable Google/GitHub sign-in and Firebase password resets; the app
# then uses AtlasCode's own email/password authentication only.
# The backend verifies every Firebase ID token's RS256 signature against
# Google's published public keys, so no service-account private key is needed.
FIREBASE_PROJECT_ID=

# --- Cody (AI companion agent) ----------------------------------------------
# Server-side secret -- never exposed to the frontend. Leave empty to disable
# Cody; /cody/chat returns a 503 rather than the app failing to boot, since
# Cody is not on the critical path for the rest of AtlasCode.
OPENROUTER_API_KEY=
CODY_MODEL=anthropic/claude-haiku-4.5
CODY_RATE_LIMIT_PER_HOUR=30
CODY_HISTORY_CONTEXT_SIZE=10
CODY_DAILY_SPEND_CAP_USD=10.0

# --- Password reset by email (local-password accounts) ---------------------
# Resend API key (https://resend.com). Leave empty to disable password reset
# by email; /auth/forgot-password then returns 503 instead of the app
# failing to boot or silently dropping emails.
RESEND_API_KEY=
# Must be a verified sender/domain in the Resend account above.
EMAIL_FROM_ADDRESS=AtlasCode <onboarding@resend.dev>
# Origin the emailed reset link points at. No trailing slash.
# Local dev: http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_PER_EMAIL_PER_HOUR=3
PASSWORD_RESET_RATE_LIMIT_PER_IP_PER_HOUR=10
