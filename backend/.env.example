# Copy to .env and fill in real values. Never commit the real .env file.

# Application
APP_NAME=AtlasCode
# true for local development, false in production
DEBUG=true

# Local dev default (SQLite). In production, set to a PostgreSQL URL, e.g.
# postgresql://user:password@host:5432/dbname
# (postgres:// / postgresql:// are normalized to the async psycopg driver automatically)
DATABASE_URL=sqlite+aiosqlite:///./atlascode.db

# Generate a real value for production, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# JSON array or comma-separated list of allowed frontend origins.
# Local dev: http://localhost:5173
# Production: your Vercel deployment URL(s), e.g. https://atlascode.vercel.app
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- Federated authentication (optional) -----------------------------------
# Firebase project id. PUBLIC value — it also ships in the web client. Leave it
# empty to disable Google/GitHub sign-in and Firebase password resets; the app
# then uses AtlasCode's own email/password authentication only.
# The backend verifies every Firebase ID token's RS256 signature against
# Google's published public keys, so no service-account private key is needed.
FIREBASE_PROJECT_ID=
