# Copy to .env.local for local overrides. Never commit the real file.

# Leave unset for local dev: Vite's dev server proxies /api to
# http://127.0.0.1:8000 (see vite.config.ts), so the default '/api' works.
#
# In production (Vercel), set this to the deployed Render backend's base URL,
# with NO trailing slash and NO /api suffix, e.g.:
# VITE_API_URL=https://atlascode-backend.onrender.com
VITE_API_URL=

# --- Firebase Authentication (optional) -------------------------------------
# Public web config from the Firebase console (Project settings > General >
# Your apps > Web app). Leave all empty to disable Google/GitHub sign-in and
# Firebase-hosted password reset; email/password auth continues to work
# through AtlasCode's own backend either way.
#
# VITE_FIREBASE_PROJECT_ID must match the backend's FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Landing page footer (optional) -----------------------------------------
# Social links and contact address shown in the landing footer / contact page.
# Safe to leave unset during development; see frontend/src/config/site.ts for
# the fallback placeholder values.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_X=
VITE_SOCIAL_GITHUB=
VITE_CONTACT_EMAIL=
VITE_LEGAL_LAST_UPDATED=
