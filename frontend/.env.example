# Copy to .env.local for local overrides. Never commit the real file.

# Leave unset for local dev: Vite's dev server proxies /api to
# http://127.0.0.1:8000 (see vite.config.ts), so the default '/api' works.
#
# In production (Vercel), set this to the deployed Render backend's base URL,
# with NO trailing slash and NO /api suffix, e.g.:
# VITE_API_URL=https://atlascode-backend.onrender.com
VITE_API_URL=
